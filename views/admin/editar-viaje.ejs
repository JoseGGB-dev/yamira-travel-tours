<%- include('../partials/header') %>

<h1>Editar viaje</h1>

<form method="POST" action="/admin/viajes/<%= viaje.id %>/editar">
  <label>Fecha</label>
  <input type="date" name="fecha" value="<%= new Date(viaje.fecha).toISOString().split('T')[0] %>" required>

  <label>Hora</label>
  <input type="time" name="hora" value="<%= viaje.hora %>" required>

  <label>Precio (S/)</label>
  <input type="number" name="precio" step="0.01" min="0" value="<%= viaje.precio %>" required>

  <label>Estado</label>
  <select name="estado" required>
    <option value="programado" <%= viaje.estado === 'programado' ? 'selected' : '' %>>Programado</option>
    <option value="completado" <%= viaje.estado === 'completado' ? 'selected' : '' %>>Completado</option>
    <option value="cancelado" <%= viaje.estado === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
  </select>

  <button type="submit" class="boton">Guardar cambios</button>
</form>

<a href="/admin/dashboard">&larr; Volver al panel</a>

<%- include('../partials/footer') %>