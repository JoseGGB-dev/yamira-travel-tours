<%- include('../partials/admin-header', { activeNav: 'dashboard' }) %>

<section class="admin-shell">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card admin-card border-0 shadow-sm overflow-hidden">
        <div class="admin-success-head">
          <span class="admin-success-icon">
            <i class="bi bi-check-circle-fill"></i>
          </span>
          <div>
            <h1 class="fw-bold mb-1">Pago confirmado</h1>
            <p class="mb-0">La reserva quedo marcada como pagada y el mensaje de WhatsApp esta listo.</p>
          </div>
        </div>

        <div class="card-body p-4">
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="admin-info-tile">
                <p>Cliente</p>
                <strong><%= reserva.nombre_cliente %></strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-info-tile">
                <p>Celular</p>
                <strong><%= reserva.celular %></strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-info-tile">
                <p>Codigo de reserva</p>
                <strong><code><%= reserva.codigo_reserva %></code></strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-info-tile">
                <p>Asientos</p>
                <strong><%= reserva.asiento %></strong>
              </div>
            </div>
            <div class="col-md-6">
              <div class="admin-info-tile">
                <p>Monto pagado</p>
                <strong>S/ <%= Number(reserva.monto || reserva.monto_total || 0).toFixed(2) %></strong>
              </div>
            </div>
          </div>

          <div class="alert alert-info border-0">
            <i class="bi bi-whatsapp me-2"></i>
            Si el navegador no abre WhatsApp automaticamente, usa el boton verde.
          </div>

          <label class="form-label fw-bold">Mensaje listo para enviar</label>
          <textarea class="form-control mb-4" rows="10" readonly><%= mensajeCliente %></textarea>

          <div class="d-flex gap-2 flex-wrap">
            <% if (linkWhatsapp) { %>
              <a href="<%= linkWhatsapp %>" target="_blank" class="btn btn-success btn-lg" id="whatsappConfirmado">
                <i class="bi bi-whatsapp me-2"></i>Enviar WhatsApp al cliente
              </a>
            <% } else { %>
              <button class="btn btn-secondary btn-lg" disabled>
                <i class="bi bi-exclamation-circle me-2"></i>Celular no valido para WhatsApp
              </button>
            <% } %>

            <a href="/admin/dashboard" class="btn btn-outline-dark btn-lg">
              <i class="bi bi-arrow-left me-2"></i>Volver al panel
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (linkWhatsapp) { %>
  <script>
    setTimeout(function() {
      window.open(<%- JSON.stringify(linkWhatsapp) %>, '_blank', 'noopener');
    }, 500);
  </script>
<% } %>

<%- include('../partials/admin-footer') %>
