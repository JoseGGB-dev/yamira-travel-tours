<%- include('../partials/header') %>

<%
  function badgeReserva(estado) {
    if (estado === 'pagado')    return 'success';
    if (estado === 'cancelado') return 'danger';
    if (estado === 'vencido')   return 'secondary';
    return 'warning';
  }
  var ocupados = asientosOcupados.length;
  var capacidad = 17; // 2..18
  var libres = capacidad - ocupados;
%>

<link rel="stylesheet" href="/css/admin.css">

<section class="admin-shell">
  <div class="container-fluid px-3 px-lg-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
      <div>
        <a href="/admin/dashboard" class="text-decoration-none small text-muted">
          <i class="bi bi-arrow-left me-1"></i>Volver al panel
        </a>
        <h2 class="fw-bold mb-1 mt-1">
          <i class="bi bi-bus-front me-2 text-primary"></i>
          <%= viaje.origen %> <i class="bi bi-arrow-right mx-1"></i> <%= viaje.destino %>
        </h2>
        <div class="text-muted small">
          <i class="bi bi-calendar me-1"></i><%= new Date(viaje.fecha).toLocaleDateString('es-PE') %>
          <span class="mx-2">·</span>
          <i class="bi bi-clock me-1"></i><%= viaje.hora %>
          <span class="mx-2">·</span>
          <i class="bi bi-cash-coin me-1"></i>S/ <%= viaje.precio %>
        </div>
      </div>
      <div class="d-flex gap-2">
        <span class="kpi-card kpi-info py-2 px-3" style="min-width:auto">
          <span class="kpi-icon"><i class="bi bi-people"></i></span>
          <span>
            <div class="kpi-label">Ocupados</div>
            <div class="kpi-value" style="font-size:1.4rem"><%= ocupados %>/<%= capacidad %></div>
          </span>
        </span>
        <span class="kpi-card kpi-success py-2 px-3" style="min-width:auto">
          <span class="kpi-icon"><i class="bi bi-check2-square"></i></span>
          <span>
            <div class="kpi-label">Libres</div>
            <div class="kpi-value" style="font-size:1.4rem"><%= libres %></div>
          </span>
        </span>
      </div>
    </div>

    <div class="row g-4">
      <!-- Mapa de asientos -->
      <div class="col-lg-5">
        <div class="card admin-card border-0 shadow-sm h-100">
          <div class="card-header bg-white border-0 pt-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Mapa de asientos</h5>
            <div class="small text-muted">Vista del vehículo</div>
          </div>
          <div class="card-body">
            <div class="bus-map">
              <div class="bus-front"><i class="bi bi-person-badge me-1"></i>Conductor</div>
              <% function seat(n) {
                   var ocupado = asientosOcupados.indexOf(n) !== -1;
                   return '<div class="seat ' + (ocupado ? 'seat-busy' : 'seat-free') + '" title="Asiento ' + n + '">' + n + '</div>';
                 } %>
              <div class="bus-row justify-content-end"><%- seat(2) %><%- seat(3) %></div>
              <div class="bus-row"><%- seat(4) %><%- seat(5) %><%- seat(6) %></div>
              <div class="bus-row"><%- seat(7) %><%- seat(8) %><div class="aisle"></div><%- seat(9) %><%- seat(10) %></div>
              <div class="bus-row"><%- seat(11) %><%- seat(12) %><div class="aisle"></div><%- seat(13) %><%- seat(14) %></div>
              <div class="bus-row"><%- seat(15) %><%- seat(16) %><%- seat(17) %><%- seat(18) %></div>
            </div>
            <div class="d-flex gap-3 justify-content-center small mt-3">
              <span><span class="legend-dot seat-free-dot"></span>Libre</span>
              <span><span class="legend-dot seat-busy-dot"></span>Ocupado</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pasajeros -->
      <div class="col-lg-7">
        <div class="card admin-card border-0 shadow-sm h-100">
          <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Pasajeros</h5>
            <div class="input-group input-group-sm admin-search">
              <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
              <input type="text" id="buscadorPax" class="form-control border-start-0" placeholder="Buscar pasajero, DNI o asiento...">
            </div>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table admin-table align-middle mb-0">
                <thead>
                  <tr>
                    <th class="text-center">Asiento</th>
                    <th>Cliente</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody id="tablaPax">
                  <% if (reservas.length === 0) { %>
                    <tr><td colspan="5" class="text-center py-5 text-muted">
                      <i class="bi bi-emoji-neutral display-6 d-block mb-2"></i>
                      Aún no hay pasajeros registrados.
                    </td></tr>
                  <% } %>
                  <% reservas.forEach(function(r) { %>
                    <tr>
                      <td class="text-center"><span class="seat-chip"><%= r.asiento %></span></td>
                      <td>
                        <div class="fw-semibold"><%= r.nombre_cliente %></div>
                        <div class="text-muted small">DNI <%= r.dni %></div>
                      </td>
                      <td>
                        <a href="https://wa.me/51<%= r.celular %>" target="_blank" class="text-decoration-none text-success">
                          <i class="bi bi-whatsapp"></i> <%= r.celular %>
                        </a>
                      </td>
                      <td>
                        <span class="badge rounded-pill bg-<%= badgeReserva(r.estado) %> <%= r.estado === 'pendiente' ? 'text-dark' : '' %>">
                          <%= r.estado %>
                        </span>
                        <% if (r.metodo_pago) { %>
                          <div class="small text-muted mt-1">
                            <%= r.metodo_pago %> · <%= r.estado_pago %>
                          </div>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <% if (r.estado === 'cancelado') { %>
                          <span class="text-muted small">—</span>
                        <% } else { %>
                          <div class="d-inline-flex gap-1">
                            <% if (r.pago_id && r.estado_pago === 'pendiente') { %>
                              <form method="POST" action="/admin/pagos/<%= r.pago_id %>/confirmar"
                                    onsubmit="return confirm('¿Confirmar este pago y avisar por WhatsApp?');">
                                <button type="submit" class="btn btn-success btn-sm" title="Confirmar y avisar">
                                  <i class="bi bi-whatsapp"></i>
                                </button>
                              </form>
                            <% } %>
                            <form method="POST" action="/admin/reservas/<%= r.id %>/cancelar"
                                  onsubmit="return confirm('¿Cancelar esta reserva?');">
                              <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancelar">
                                <i class="bi bi-x-lg"></i>
                              </button>
                            </form>
                          </div>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var input = document.getElementById('buscadorPax');
    var tbody = document.getElementById('tablaPax');
    if (!input || !tbody) return;
    input.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      Array.prototype.forEach.call(tbody.querySelectorAll('tr'), function(tr) {
        tr.style.display = tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
